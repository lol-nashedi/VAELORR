------------------------------------------------------------------ http / firebase
local function encode(v)
    local t = type(v)
    if t == "table" then return HttpService:JSONEncode(v) end
    if t == "string" then return HttpService:JSONEncode({v}):sub(2, -2) end
    return tostring(v)
end

local function http(method, path, body)
    if not req then return nil end
    local opts = {Url = DB .. path .. ".json", Method = method}
    if body ~= nil then
        opts.Headers = {["Content-Type"] = "application/json"}
        opts.Body = encode(body)
    end
    local ok, res = pcall(req, opts)
    if not ok or not res then return nil end
    return res
end

local function okRes(r) return r ~= nil and (r.Success == true or r.StatusCode == 200) end

local function fbGet(path)
    local r = http("GET", path)
    if not r or not r.Body or r.Body == "" or r.Body == "null" then return nil end
    local ok, d = pcall(function() return HttpService:JSONDecode("[" .. r.Body .. "]")[1] end)
    return ok and d or nil
end
local function fbPut(path, v) return okRes(http("PUT", path, v)) end
local function fbPost(path, v) return okRes(http("POST", path, v)) end
local function fbDelete(path) return okRes(http("DELETE", path)) end

