local sendBusy = false
sendBtn.Activated:Connect(function()
    if sendBusy then return end
    local left = 180 - (os.time() - lastShare)
    if lastShare > 0 and left > 0 then notify("WAIT " .. left .. "s BEFORE NEXT SHARE", C.Danger) return end
    if not target then notify("SELECT A FRIEND FIRST", C.Warning) return end
    local code = trim(shCode.Text)
    local name = trim(shName.Text)
    if not code:match("^BH%-AE%-") then notify("PLEASE PUT LEGIT CODE", C.Danger) return end
    if name == "" then name = "Shared Outfit" end
    sendBusy = true
    sendBtn.Text = "SENDING..."
    task.spawn(function()
        local ok = fbPut("outfit_shares/" .. target.Id .. "/" .. HttpService:GenerateGUID(false), {
            sender = LP.Name, senderDisplay = LP.DisplayName, senderId = LP.UserId,
            outfitCode = code, outfitName = name, timestamp = os.time(),
        })
        if ok then
            lastShare = os.time()
            notify("SENT TO " .. target.Display, C.Success)
            SM.close()
        else
            notify("SEND FAILED - check DB rules", C.Danger)
        end
        sendBusy = false
        sendBtn.Text = "SEND OUTFIT"
    end)
end)

