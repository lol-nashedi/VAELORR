local function fetchCodes(force)
    if not force and #codes > 0 and os.time() - codesT < TTL then return codes end
    local data = fbGet("avatarcodes") or {}
    local out, now = {}, os.time()
    for k, v in pairs(data) do
        if type(v) == "table" and v.timestamp and now - v.timestamp <= 2592000 then
            v.id = k
            v.code = v.Code or v.code
            table.insert(out, v)
        end
    end
    codes, codesT = out, now
    return out
end

local function fetchSaved(force)
    if not force and os.time() - savedT < TTL then return savedSet end
    local data = fbGet("savedcodes/" .. LP.UserId) or {}
    local out = {}
    for k in pairs(data) do out[k] = true end
    savedSet, savedT = out, os.time()
    return out
end

local function fetchViews(force)
    if not force and next(viewsMap) ~= nil and os.time() - viewsT < TTL then return viewsMap end
    local data = fbGet("outfit_views") or {}
    local out = {}
    for k, v in pairs(data) do if type(v) == "number" then out[k] = v end end
    viewsMap, viewsT = out, os.time()
    return out
end

local function recordView(id)
    if seenView[id] then return viewsMap[id] or 0 end
    seenView[id] = true
    local n = fbGet("outfit_views/" .. id)
    n = (type(n) == "number" and n or 0) + 1
    fbPut("outfit_views/" .. id, n)
    viewsMap[id] = n
    return n
end

local function getAvatar(id)
    if avatarCache[id] then return avatarCache[id] end
    local ok, img = pcall(function()
        return Players:GetUserThumbnailAsync(id, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size420x420)
    end)
    if ok and img then avatarCache[id] = img return img end
end

