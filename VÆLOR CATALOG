local giftQueue, giftBusy, curKey, curGift = {}, false, nil, nil
local seenGifts = {}
local nextGift

local function finishGift()
    local key = curKey
    GM2.close()
    task.spawn(function() fbDelete("outfit_shares/" .. LP.UserId .. "/" .. key) end)
    curKey, curGift = nil, nil
    task.delay(0.5, function()
        giftBusy = false
        nextGift()
    end)
end

function nextGift()
    if giftBusy or #giftQueue == 0 or not alive then return end
    giftBusy = true
    local item = table.remove(giftQueue, 1)
    curKey, curGift = item[1], item[2]
    gName.Text = curGift.senderDisplay or curGift.sender or "Unknown"
    gUser.Text = "@" .. (curGift.sender or "unknown")
    gOutfit.Text = curGift.outfitName or "Outfit"
    gCode.Text = curGift.outfitCode or ""
    gAvatar.Image = ""
    task.spawn(function()
        pcall(function()
            local id = curGift.senderId or Players:GetUserIdFromNameAsync(curGift.sender or "Roblox")
            local img = Players:GetUserThumbnailAsync(id, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size180x180)
            if gAvatar.Parent then gAvatar.Image = img end
        end)
    end)
    GM2.open()
end

gAccept.Activated:Connect(function()
    if not curGift then return end
    local code = curGift.outfitCode
    if code and getRemote() then
        task.spawn(function() loadOutfit(code) end)
    end
    if code and copyFn then pcall(copyFn, code) end
    notify("ACCEPTED - code copied", C.Success)
    finishGift()
end)
gReject.Activated:Connect(function()
    if not curGift then return end
    notify("REJECTED", C.Warning)
    finishGift()
end)

task.spawn(function()
    while alive and gui.Parent do
        local data = fbGet("outfit_shares/" .. LP.UserId)
        if type(data) == "table" then
            local now = os.time()
            for k, g in pairs(data) do
                if type(g) == "table" and not seenGifts[k] then
                    seenGifts[k] = true
                    if now - (g.timestamp or 0) <= 1800 then
                        table.insert(giftQueue, {k, g})
                    else
                        fbDelete("outfit_shares/" .. LP.UserId .. "/" .. k)
                    end
                end
            end
            nextGift()
        end
        task.wait(5)
    end
end)

