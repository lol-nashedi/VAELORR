function renderCodes(m, force)
    renderToken += 1
    local my = renderToken
    mode = m or mode
    setNav(mode)
    for _, c in ipairs(list:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
    rows = {}
    sel = nil
    showCreator()
    local loading = label(list, "Loading…", UDim2.new(), UDim2.new(1, -6, 0, 40), {ts = 12, color = C.Dim})

    local saved = fetchSaved(force)
    local all = fetchCodes(force)
    local vm = fetchViews(force)
    if my ~= renderToken or not alive then return end
    loading:Destroy()

    local data = {}
    for _, e in ipairs(all) do e.trending = false; table.insert(data, e) end
    table.sort(data, function(a, b)
        local va, vb = vm[a.id] or 0, vm[b.id] or 0
        if va ~= vb then return va > vb end
        return (a.timestamp or 0) > (b.timestamp or 0)
    end)
    local t = 0
    for _, e in ipairs(data) do
        if t < 3 and (vm[e.id] or 0) > 0 then e.trending = true; t += 1 end
    end

    local q = searchBox.Text:lower()
    local shown = 0
    for _, e in ipairs(data) do
        local ok = true
        if mode == "MyCodes" and tostring(e.uploaderId) ~= tostring(LP.UserId) then ok = false end
        if mode == "Saved" and not saved[e.id] then ok = false end
        if #q > 0 and not (e.Name or ""):lower():find(q, 1, true) then ok = false end
        if ok then
            shown += 1
            addRow(e, shown)
        end
    end
    if shown == 0 then
        local l = label(list, "No codes yet.\nUpload one to start!", UDim2.new(), UDim2.new(1, -6, 0, 60), {ts = 12, color = C.Dim, wrap = true})
        l.LayoutOrder = 1
    end
end

