-- auto scale for small phone screens
local fitters = {}
local function fit(sc, w, h)
    local function upd()
        local v = Cam.ViewportSize
        sc.Scale = math.clamp(math.min(v.X * 0.96 / w, v.Y * 0.94 / h), 0.4, 1)
    end
    upd()
    table.insert(fitters, upd)
end
Cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    for _, f in ipairs(fitters) do f() end
end)

