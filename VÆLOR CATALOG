local function modal(w, h, z, accent, lock)
    local back = make("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, Visible = false, ZIndex = z,
    }, gui)
    local card = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = C.Base, BackgroundTransparency = 0.05,
        BorderSizePixel = 0, ClipsDescendants = true, Active = true,
    }, back)
    corner(card, 16); stroke(card, accent or C.Neon, 1.4, 0.3)
    grad(card, C.White, Color3.fromRGB(232, 245, 255), 45)
    fit(make("UIScale", {}, card), w, h)
    local m = {back = back, card = card, n = 0}
    function m.open()
        m.n += 1
        back.Visible = true; back.BackgroundTransparency = 1
        card.Size = UDim2.fromOffset(0, 0)
        tw(back, 0.2, {BackgroundTransparency = 0.6})
        tw(card, 0.3, {Size = UDim2.fromOffset(w, h)}, BACK)
    end
    function m.close()
        if not back.Visible then return end
        m.n += 1
        local my = m.n
        tw(back, 0.2, {BackgroundTransparency = 1})
        tw(card, 0.2, {Size = UDim2.fromOffset(0, 0)})
        task.delay(0.22, function() if m.n == my then back.Visible = false end end)
    end
    if not lock then back.Activated:Connect(m.close) end
    return m
end

