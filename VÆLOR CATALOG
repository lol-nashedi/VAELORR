local function buildFriends()
    for _, c in ipairs(fList:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
    local n = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            n += 1
            local b = make("TextButton", {Size = UDim2.new(1, -6, 0, 44), BackgroundColor3 = C.Card, BackgroundTransparency = 0.35, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = n}, fList)
            b.Name = "Friend"
            corner(b, 10)
            local img = make("ImageLabel", {Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 6, 0.5, -17), BackgroundColor3 = C.Card, BorderSizePixel = 0, Image = ""}, b)
            corner(img, 17)
            task.spawn(function()
                pcall(function()
                    local t = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                    if img.Parent then img.Image = t end
                end)
            end)
            label(b, p.DisplayName, UDim2.fromOffset(48, 5), UDim2.new(1, -80, 0, 18), {ts = 12, xa = Enum.TextXAlignment.Left, trunc = Enum.TextTruncate.AtEnd})
            label(b, "@" .. p.Name, UDim2.fromOffset(48, 22), UDim2.new(1, -80, 0, 14), {font = GM, ts = 10, color = C.Dim, xa = Enum.TextXAlignment.Left, trunc = Enum.TextTruncate.AtEnd})
            local check = label(b, "✓", UDim2.new(1, -28, 0.5, -11), UDim2.fromOffset(22, 22), {ts = 16, color = C.Success})
            check.Name = "Check"; check.Visible = false
            b.Activated:Connect(function()
                for _, o in ipairs(fList:GetChildren()) do
                    if o.Name == "Friend" then
                        tw(o, 0.15, {BackgroundColor3 = C.Card})
                        o.Check.Visible = false
                    end
                end
                tw(b, 0.15, {BackgroundColor3 = C.CardHover})
                check.Visible = true
                target = {Name = p.Name, Display = p.DisplayName, Id = p.UserId}
            end)
        end
    end
    if n == 0 then
        local l = label(fList, "No other players in this server.", UDim2.new(), UDim2.new(1, -6, 0, 44), {ts = 11, color = C.Dim})
        l.LayoutOrder = 1
    end
end

shareBtn.Activated:Connect(function()
