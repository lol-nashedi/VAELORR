local smallMap = {a="ᴀ",b="ʙ",c="ᴄ",d="ᴅ",e="ᴇ",f="ꜰ",g="ɢ",h="ʜ",i="ɪ",j="ᴊ",k="ᴋ",l="ʟ",m="ᴍ",n="ɴ",o="ᴏ",p="ᴘ",q="ǫ",r="ʀ",s="s",t="ᴛ",u="ᴜ",v="ᴠ",w="ᴡ",x="x",y="ʏ",z="ᴢ"}
local function smallCaps(s)
    local out = ""
    for i = 1, #s do
        local ch = s:sub(i, i)
        out = out .. (smallMap[ch:lower()] or ch)
    end
    return out
end

local function trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end

local function commas(n)
    local s = tostring(math.floor(n or 0))
    local out = ""
    local c = 0
    for i = #s, 1, -1 do
        c += 1
        out = s:sub(i, i) .. out
        if c % 3 == 0 and i > 1 then out = "," .. out end
    end
    return out
end

local function countKeys(t)
    local n = 0
    if type(t) == "table" then for _ in pairs(t) do n += 1 end end
    return n
end

